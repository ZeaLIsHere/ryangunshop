# Normalisasi akhir baris agar tidak muncul perubahan palsu antar sistem operasi.
* text=auto eol=lf

# Berkas biner tidak boleh diubah akhir barisnya.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.tflite binary

# Skrip Windows tetap memakai CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
